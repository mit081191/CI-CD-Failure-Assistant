{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Streamlit: app.py",
      "type": "debugpy",
      "request": "launch",
      "module": "streamlit",
      "args": ["run", "app.py"],
      "cwd": "${workspaceFolder}",
      "justMyCode": true
    },
    {
      "name": "Run all scenarios (with LLM)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/run_scenarios.py",
      "args": ["--model", "qwen3:8b"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "Run all scenarios (no LLM)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/run_scenarios.py",
      "args": ["--no-llm"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    }
  ]
}